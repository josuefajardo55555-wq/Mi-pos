rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuarios ──────────────────────────────────────────────────────────────
    // Cada usuario autenticado puede leer y escribir su propio documento.
    // Los owners pueden leer todos los usuarios (vista de administración).
    match /users/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner");
      allow write: if request.auth != null &&
                      (request.auth.uid == userId ||
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner");

      // Configuración personal (impresora, preferencias, etc.)
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Locales ───────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede operar sobre los datos de los locales.
    match /locals/{localId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Colecciones legacy (antes de la migración a locales) ─────────────────
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }
  }
}
